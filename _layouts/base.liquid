  <meta name="description" content="{{ site.description }}" />
  <meta name="viewport" content="width=device-width, initial-scale=1">

  <link rel="alternate" type="application/rss+xml" href="{{ website_origin }}/atom.xml" />

  {% include site-styles.html origin=website_origin %}
